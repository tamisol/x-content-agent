# Copy to .env.local and adjust. Never commit real keys.
# All of these are SERVER-SIDE ONLY (read in src/lib/ai-provider.ts,
# which runs in the API route). Nothing here is exposed to the client.

# Provider selector: "ollama" (local, default) or "openai" (reserved for future use).
AI_PROVIDER=ollama

# Ollama server address. Default when unset: http://localhost:11434
# Change this only if your Ollama runs on another host/port.
AI_BASE_URL=http://localhost:11434

# Ollama model tag to use. Must be pulled first, e.g. `ollama pull llama3.2`.
# Recommended for this project: llama3.2 (small, fast, good enough for short posts).
AI_MODEL=llama3.2

# Optional. Local Ollama does NOT need a key — leave empty.
# Only required if you later switch AI_PROVIDER to a cloud provider.
AI_API_KEY=
# Alias also supported:
# OPENAI_API_KEY=
