# Copy to .env.local and adjust. Never commit real keys.
# All of these are SERVER-SIDE ONLY (read in src/lib/ai-provider.ts,
# which runs in the API route). Nothing here is exposed to the client.

# Provider selector: "ollama" (local, default) or "groq" (cloud, free tier).
AI_PROVIDER=ollama

# Ollama server address. Default when unset: http://localhost:11434
# Change this only if your Ollama runs on another host/port.
AI_BASE_URL=http://localhost:11434

# Model to use.
# - Ollama: must be pulled first, e.g. `ollama pull llama3.2`.
#   Recommended: llama3.2 (small, fast, good enough for short posts).
# - Groq: a Groq model id, e.g. openai/gpt-oss-120b (the default).
#   Check https://console.groq.com/docs/models for current ids.
AI_MODEL=llama3.2

# API key. Optional for local Ollama — leave empty.
# REQUIRED for Groq: free key from https://console.groq.com/keys
# (no credit card). Set GROQ_API_KEY or AI_API_KEY, then AI_PROVIDER=groq.
AI_API_KEY=
# Aliases also supported:
# GROQ_API_KEY=
# OPENAI_API_KEY=
